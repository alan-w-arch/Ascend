<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#EAF4EE">
    <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ascend · Water" android:textColor="#1D3828" android:textStyle="bold" android:textSize="14sp"/>
    <TextView android:id="@+id/widget_water_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 / 2000 ml" android:textColor="#1D3828" android:textSize="18sp" android:paddingTop="6dp"/>
    <Button android:id="@+id/widget_add_water" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+250 ml"/>
</LinearLayout>